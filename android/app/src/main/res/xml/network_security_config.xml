<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP only to Tailscale MagicDNS names (*.ts.net), where
     hex-vocab-sync listens; WireGuard already encrypts that traffic.
     Everything else stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ts.net</domain>
    </domain-config>
</network-security-config>
